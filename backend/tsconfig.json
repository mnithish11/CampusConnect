{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "declaration": false,
    "noEmit": true
  },
  "include": ["src/server.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "src/server.backup.ts",
    "src/server.before-connection-fix.ts"
  ]
}
